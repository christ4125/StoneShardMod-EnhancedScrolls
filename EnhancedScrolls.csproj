<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dynamically links your project code straight into the ModShardLauncher ecosystem -->
    <Reference Include="ModShardLauncher">
      <HintPath>..\..\ModShardLauncher.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UndertaleModLib">
      <HintPath>..\..\UndertaleModLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
